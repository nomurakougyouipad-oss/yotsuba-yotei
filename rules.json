{
  "rules": {
    ".read": false,
    ".write": false,

    "yotei": {
      ".read": true,
      ".write": true,

      "members": {
        "$memberId": {
          ".validate": "newData.hasChildren(['name','kubun','order','active'])",

          "id":       { ".validate": "newData.isString() && newData.val() === $memberId" },
          "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
          "kubun":    { ".validate": "newData.isString() && (newData.val() === '自社' || newData.val() === '協力')" },
          "shozoku":  { ".validate": "newData.isString() && newData.val().length <= 30" },
          "order":    { ".validate": "newData.isNumber()" },
          "active":   { ".validate": "newData.isBoolean()" },

          "$other": { ".validate": false }
        }
      },

      "jobs": {
        "$jobId": {
          ".validate": "newData.hasChildren(['name','category','order','active'])",

          "id":       { ".validate": "newData.isString() && newData.val() === $jobId" },
          "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "no":       { ".validate": "newData.isString() && newData.val().length <= 30" },
          "start":    { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))" },
          "category": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
          "order":    { ".validate": "newData.isNumber()" },
          "active":   { ".validate": "newData.isBoolean()" },

          "$other": { ".validate": false }
        }
      },

      "weeks": {
        "$week": {
          ".validate": "$week.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",

          "assign": {
            "$jobId": {
              "$date": {
                ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",

                "members": {
                  "$name": {
                    "mark": {
                      ".validate": "newData.isString() && newData.val().length <= 4"
                    },
                    "ord": { ".validate": "newData.isNumber()" },
                    "$other": { ".validate": false }
                  }
                },

                "extras": {
                  "$i": { ".validate": "newData.isString() && newData.val().length <= 40" }
                },

                "$other": { ".validate": false }
              }
            }
          },

          "show": {
            "$jobId": { ".validate": "newData.isBoolean()" }
          },

          "updatedAt": { ".validate": "newData.isNumber()" },
          "updatedBy": { ".validate": "newData.isString() && newData.val().length <= 20" },

          "$other": { ".validate": false }
        }
      },

      "billed": {
        "$ym": {
          ".validate": "$ym.matches(/^[0-9]{4}-[0-9]{2}$/)",
          "$jobId": { ".validate": "newData.isBoolean() && newData.val() === true" }
        }
      },

      "meta": {
        "lastWeek": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" }
      }
    }
  }
}
